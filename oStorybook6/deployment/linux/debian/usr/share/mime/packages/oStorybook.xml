<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/vnd.oStorybook">
        <comment>oStorybook document</comment>
        <comment xml:lang="de">oStorybook dokument</comment>
        <comment xml:lang="en">oStorybook Document</comment>
        <comment xml:lang="es">Documento de oStorybook</comment>
        <comment xml:lang="fr">Document oStorybook</comment>
        <comment xml:lang="hu">oStorybook dokumentum</comment>
        <comment xml:lang="it">oStorybook Documento</comment>
        <comment xml:lang="pt">Documento do oStorybook</comment>
        <glob pattern="*.osbk" />
        <magic priority="25">
            <match type="string" value="&lt;project" offset="0" />
        </magic>
        <generic-icon name="application-xml" />
        <sub-class-of type="application/xml" />
    </mime-type>
</mime-info>